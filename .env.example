# Robinhood Chain defaults for @veyanet/sdk
# Copy to .env locally. Never commit a funded private key.

ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=46630
ROBINHOOD_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# VEYA Protocol Contract (Veya.sol for commitments, spend limits & memory nullifiers)
VEYA_PROTOCOL_CONTRACT_ADDRESS=0x1a1Dc3c55550FCE9F70ef6cDEeF967c0b72a5d84

# Optional — VEYA Token Contract (Reserved for future token launch)
# VEYA_TOKEN_CONTRACT_ADDRESS=0x

# Optional — hex key for EvmAnchor writes (funded testnet ETH)
# VEYA_DEPLOYER_PRIVATE_KEY=0x

VEYA_VALIDATOR_NODES=http://127.0.0.1:7701,http://127.0.0.1:7702,http://127.0.0.1:7703
VEYA_SEALED_NODE_URL=http://127.0.0.1:7800
VEYA_SDK_TIMEOUT_MS=15000
