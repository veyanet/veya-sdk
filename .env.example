# @veyanet/sdk
# Copy to .env locally. Never commit a private key.
#
# Leave ROBINHOOD_NETWORK unset and the client uses Mainnet.
# Set ROBINHOOD_NETWORK=testnet to keep the previous profile.

# Mainnet (default when ROBINHOOD_NETWORK is unset)
# ROBINHOOD_NETWORK=mainnet
# ROBINHOOD_MAINNET_CHAIN_ID=4663
# ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# ROBINHOOD_MAINNET_EXPLORER_URL=https://robinhoodchain.blockscout.com
# VEYA_MAINNET_CONTRACT_ADDRESS=0x87dC582eEA544A434a5C1e30Ca3d12c1e548a674
# VEYA_MAINNET_RELAYER_PRIVATE_KEY=

# Testnet profile. Used only when ROBINHOOD_NETWORK=testnet or network is "testnet".
# ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
# ROBINHOOD_CHAIN_ID=46630
# ROBINHOOD_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
# VEYA_CONTRACT_ADDRESS=0x1a1Dc3c55550FCE9F70ef6cDEeF967c0b72a5d84
# VEYA_DEPLOYER_PRIVATE_KEY=

# Validator and sealed-node processes run on this machine.
# There is no public URL for them. These lines do not replace https://api.veyanet.tech.
VEYA_VALIDATOR_NODES=http://127.0.0.1:7701,http://127.0.0.1:7702,http://127.0.0.1:7703
VEYA_SEALED_NODE_URL=http://127.0.0.1:7800
VEYA_SDK_TIMEOUT_MS=15000
